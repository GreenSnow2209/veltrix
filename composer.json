{
    "name": "veltrix/laravel-admin",
    "description": "Modern, feature-compatible successor to laravel-admin. Familiar to Build. Modern by Design.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "veltrix",
        "crud",
        "grid",
        "form",
        "dashboard",
        "rbac"
    ],
    "homepage": "https://github.com/veltrix/laravel-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Veltrix Core Team",
            "email": "core@veltrix.dev"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/translation": "^11.0 || ^12.0 || ^13.0",
        "symfony/dom-crawler": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Veltrix\\": "src/",
            "Encore\\Admin\\": "compatibility/Encore/Admin/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Veltrix\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Veltrix\\VeltrixServiceProvider",
                "Encore\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Veltrix": "Veltrix\\Facades\\Veltrix",
                "Admin": "Encore\\Admin\\Facades\\Admin"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
