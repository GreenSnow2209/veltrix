<?php

namespace DummyNamespace;

use App\Models\User;
use Veltrix\Controllers\AdminController;
use Veltrix\Form\Form;
use Veltrix\Grid\Grid;
use Veltrix\Show\Show;

class ExampleController extends AdminController
{
    protected string $title = 'Example Resource';

    protected function grid(): Grid
    {
        $grid = new Grid(new User());

        $grid->column('id', 'ID')->sortable();
        $grid->column('name', 'Name');
        $grid->column('email', 'Email');
        $grid->column('created_at', 'Created at')->sortable();
        $grid->column('updated_at', 'Updated at')->sortable();

        return $grid;
    }

    protected function detail(mixed $id): Show
    {
        $show = new Show(User::findOrFail($id));

        $show->field('id', 'ID');
        $show->field('name', 'Name');
        $show->field('email', 'Email');
        $show->field('created_at', 'Created at');
        $show->field('updated_at', 'Updated at');

        return $show;
    }

    protected function form(): Form
    {
        $form = new Form(new User());

        $form->display('id', 'ID');
        $form->text('name', 'Name')->required();
        $form->email('email', 'Email')->required();

        return $form;
    }
}
